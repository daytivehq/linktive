# Keep local review materials and artifacts private.
/docs/*
!/docs/NEXT_IMPROVEMENTS.md
!/docs/chrome-web-store-guide.md

# Binaries, test, and coverage outputs
/bin/
/dist/
*.exe
*.test
*.out
*.log
coverage.txt
coverage.html

# Data, SQLite files, and backups
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment files
.env
.env.*
!.env.example

# Frontend (React / Vite)
node_modules/
/web/dist/
/web/.vite/
/web/*.tsbuildinfo

# Browser extension
/extension/dist/
/extension/*.zip

# Android packages and signing credentials
*.apk
*.apks
*.aab
*.jks
*.keystore
*.p12
keystore.properties
signing.properties

# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
