{
  "manifest_version": 3,
  "name": "linktive",
  "version": "0.1.0",
  "description": "현재 페이지를 빠르게 저장하고 주소창에서 'lk'로 북마크를 즉시 검색하세요.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "linktive에 북마크 저장",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "lk"
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "linktive 북마크 저장 팝업 열기"
    }
  }
}
